10 "A" CLEAR: RANDOM: W=&C53B, X=&C53A, Y=&C500, Z=&C4F5, M=2, R=4, S=0
20 WAIT 200: PRINT "=CATCH THE PAC!="
30 WAIT 0: PRINT "": CALL &11E0: T=9, Q=0, U=1, V=-1, H=1, K=1, C=0, P=99: GOSUB 500
40 POKE X,1: POKE W,8: CALL Y: POKE X,11: POKE W,9: CALL Y 
50 FOR I=2 TO 10: POKE Z+I,1: POKE X,I: POKE W,1: CALL Y: NEXT I

100 IF Q LET K=1-K: IF K=0 GOTO 150
110 L=VAL INKEY$: IF L=4 OR L=6 LET H=-(L=4)+(L=6)
130 A=PEEK(Z+M): POKE X,M: POKE W,A: CALL Y: M=M+H: IF M=1 LET M=10
140 IF M=11 LET M=2
150 POKE X,M: POKE W,3+(Q>0): CALL Y
160 IF N=M GOSUB 600

200 B=PEEK(Z+N): T=T-B: POKE Z+N,0: IF T=0 GOTO 400
210 U=1-U: IF Q LET Q=Q-1: GOTO 240
220 IF U=0 AND B GOTO 300
230 IF (RND 2R=1) AND (ABS(N-M)<5-R) AND (RND(ABS(P-N))>2) LET V=1: IF N<M LET V=-1
240 POKE X,N: POKE W,0: CALL Y: N=N+V: IF N=1 LET N=10
250 IF N=11 LET N=2

300 POKE W,6+UV: POKE X,N: CALL Y: IF N=M GOSUB 600
320 IF B<2 GOTO 100
330 P=99: Q=8: V=-1: IF N<M LET V=1
340 IF R<3 AND ((N<5 AND M>5 AND V=1) OR (N>5 AND M<5 AND V=-1)) LET V=V*-1
350 GOTO 100

400 FOR I=0 TO 2: CALL &11E5: GOSUB 430: CALL &11E0: GOSUB 430: NEXT I: GOSUB 500: R=R-1: IF R=0 LET R=2
410 IF C GOTO 30
420 GOTO 700
430 FOR J=0 TO 9: NEXT J: RETURN

500 N=2+(M<6)*8: IF M=6 LET N=2+((RND 2)-1)*8
510 V=-1: IF N<M LET V=1
520 IF ABS(P-N)<ABS(M-N) LET V=1: IF P<N LET V=-1
530 U=1: RETURN

600 IF Q GOTO 700
610 POKE X,N: FOR I=10 TO 14: POKE W,I: CALL Y: FOR J=0 TO 6: NEXT J: NEXT I: POKE W,0: CALL Y
620 GOSUB 500: S=S+T*10: C=1, J=1+(M<6)*5: FOR I=J TO J+5
630 IF PEEK(Z+I)=0 POKE Z+I,1: POKE X,I: POKE W,1: CALL Y: T=T+1
640 NEXT I
650 P=1+RND 9: IF P=N GOTO 650
660 T=T+2-PEEK(Z+P): POKE Z+P,2: POKE X,P: POKE W,2: CALL Y: POKE X,N: POKE W,6: CALL Y: U=1: RETURN

700 WAIT 200: PRINT "MONSTER LOSE...": PRINT "SCORE=";S: END
