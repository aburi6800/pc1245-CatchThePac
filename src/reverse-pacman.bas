1 "B" A=PEEK(Z+PEEK X): POKE W,A: CALL Y: RETURN
10 "A" CLEAR: RANDOM: W=&C53B, X=&C53A, Y=&C500, Z=&C4F5, M=2, N=10, S=0: WAIT 200: PRINT "=REVERSE PACMAN="

20 WAIT 0: PRINT "": CALL &11E0: POKE X,1: POKE W,8: CALL Y: POKE X,11: POKE W,9: CALL Y
30 POKE X,M: POKE W,3: CALL Y: POKE W, 5: POKE X,N: CALL Y: T=0: FOR I=2 TO 10
40 IF I<>M AND I<>N POKE Z+I,1: POKE X,I: POKE W,1: CALL Y
50 NEXT I
60 P=3+RND 5: IF P=M OR P=N GOTO 60
70 POKE Z+P,2: POKE X,P: POKE W,2: CALL Y: T=8, Q=0, U=1, V=-1: IF N>M LET V=1
80 IF ABS(P-N)<ABS(M-N) AND P>N LET V=1

100 IF N=M GOSUB 600
110 L=ASC INKEY$: IF L=52 POKE X,M: GOSUB "B": M=M-1: IF M=1 LET M=10
120 IF L=54 POKE X,M: GOSUB "B": M=M+1: IF M=11 LET M=2
130 POKE X,M: POKE W,3+(Q>0): CALL Y

200 U=1-U: IF U=0 AND Q=0 GOTO 300
210 IF T=0 GOTO 400
220 IF Q>0 GOTO 250
230 IF (V=-1) AND (N>M) AND (N-M<4) AND (ABS(N-P)>2) LET V=1: GOTO 250
240 IF (V=1) AND (M>N) AND (M-N<4) AND (ABS(N-P)>2) LET V=-1
250 POKE X,N: POKE W,0: CALL Y: N=N+V: IF N=1 LET N=10
260 IF N=11 LET N=2

300 POKE W,6+UV: POKE X,N: CALL Y: A=PEEK(Z+N): T=T-A: POKE Z+N,0: IF A<2 GOTO 100
310 Q=8: V=-1: IF N<M LET V=1
320 GOTO 100

400 FOR I=0 TO 2: CALL &11E5: GOSUB 430: CALL &11E0: GOSUB 430: NEXT I: GOSUB 500: GOTO 20
430 FOR J=0 TO 19: NEXT J: RETURN

500 IF M=2 OR M=10 LET N=6: RETURN
510 N=(((RND 2)-1)*(M=6))*8+2:IF M<6 LET N=10
520 RETURN

600 IF Q>0 WAIT 200: PRINT "MONSTER LOSE...": PRINT "SCORE=";S: END
610 POKE X,N: FOR I=0 TO 4: POKE W,10+I: CALL Y: FOR J=0 TO 9: NEXT J: NEXT I: GOSUB 500: S=S+T*10: RETURN
