10 "A" CLEAR: RANDOM: W=&C53B, X=&C53A, Y=&C500, Z=&C4F5, M=2, N=10, R=4, S=0: WAIT 200: PRINT "=CATCH THE PAC!="
20 WAIT 0: PRINT "": CALL &11E0: T=8, Q=0, U=1, V=-1, H=1: K=1: GOSUB 500: POKE X,1: POKE W,8: CALL Y: POKE X,11: POKE W,9: CALL Y 
30 POKE X,M: POKE W,3: CALL Y: POKE W,5: POKE X,N: CALL Y: FOR I=2 TO 10
40 IF I<>M AND I<>N POKE Z+I,1: POKE X,I: POKE W,1: CALL Y
50 NEXT I
60 P=3+RND 5: IF P=M OR P=N GOTO 60
70 POKE Z+P,2: POKE X,P: POKE W,2: CALL Y

100 A=PEEK(Z+M): IF A=0 LET K=1-K: IF K=0 GOTO 150
110 L=VAL INKEY$: IF L=4 LET H=-1
120 IF L=6 LET H=1
130 POKE X,M: POKE W,A: CALL Y: M=M+H: IF M=1 LET M=10
140 IF M=11 LET M=2
150 POKE X,M: POKE W,3+(Q>0): CALL Y
160 IF N=M GOSUB 600

200 IF T=0 GOTO 400
210 U=1-U: IF U=0 AND B>0 GOTO 300
220 IF Q LET Q=Q-1: GOTO 260
230 IF RND R>1 GOTO 260
240 IF (V=-1) AND (N>M) AND (ABS(P-N)>ABS(M-N)) LET V=1: GOTO 260
250 IF (V=1) AND (N<M) AND (ABS(P-N)>ABS(M-N)) LET V=-1
260 POKE X,N: POKE W,0: CALL Y: N=N+V: IF N=1 LET N=10
270 IF N=11 LET N=2

300 POKE W,6+UV: POKE X,N: CALL Y: B=PEEK(Z+N): T=T-B: POKE Z+N,0: IF N=M GOSUB 600
310 IF B<2 GOTO 100
320 P=99: Q=8: V=-1: IF N<M LET V=1
330 GOTO 100

400 FOR I=0 TO 2: CALL &11E5: GOSUB 420: CALL &11E0: GOSUB 420: NEXT I: GOSUB 500: R=R-1: IF R=0 LET R=4
410 GOTO 20
420 FOR J=0 TO 9: NEXT J: RETURN

500 N=2+(M<6)*8:IF M=6 LET N=((RND 2)-1)*8+2
510 V=-1: IF N<M LET V=1
520 IF ABS(P-N)<ABS(M-N) LET V=1: IF P<N LET V=-1
530 RETURN

600 IF Q WAIT 200: PRINT "MONSTER LOSE...": PRINT "SCORE=";S: END
610 POKE X,N: FOR I=10 TO 14: POKE W,I: CALL Y: FOR J=0 TO 9: NEXT J: NEXT I: GOSUB 500: S=S+T*10: RETURN
