10 "A" CLEAR: RANDOM: W=&C53B, X=&C53A, Y=&C500, M=3, N=9, V=-1, U=0: WAIT 200: PRINT "=REVERSE PACMAN="
15 GOSUB 20: GOTO 40
20 WAIT 0: PRINT "": POKE X,1: POKE W,7: CALL Y: POKE X,11: POKE W,8: CALL Y: CALL &11E0: RETURN
30 "B" A=PEEK(&C4F5+PEEK X): POKE W,A: CALL Y: RETURN

40 FOR L=1 TO 9: POKE &C4F6+L,1: NEXT L: POKE (&C4F9+RND 3),2
45 FOR L=1 TO 9: POKE X,L+1: A=&C4F6+L:POKE W,(PEEK A): CALL Y: NEXT L: T=10

50 L=ASC INKEY$: IF L=52 POKE X,M: GOSUB "B": M=M-1: IF M=1 LET M=10
60 IF L=54 POKE X,M: GOSUB "B": M=M+1: IF M=11 LET M=2
70 POKE X,M: POKE W,3: CALL Y

80 U=1-U: IF U GOTO 100
90 T=T-PEEK(&C4F5+N): IF T=0 GOTO 40
100 POKE &C4F5+N, 0: POKE X,N: POKE W,0: CALL Y: N=N+V: IF N=1 LET N=10
110 IF N=11 LET N=2
120 POKE W, 5+UV: POKE X,N: CALL Y
130 GOTO 50
