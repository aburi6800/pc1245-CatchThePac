{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "assemble",
            "type": "shell",
            "command": "source ${workspaceFolder}/.vscode/tasks.env; perl ${workspaceFolder}/assembler/yasm.pl -r ${workspaceFolder}/dist/$PRODUCT_NAME.bin ${workspaceFolder}/src/$PRODUCT_NAME.asm"
        },
        {
            "label": "bas2img",
            "type": "shell",
            "command": "source ${workspaceFolder}/.vscode/tasks.env; bas2img --pc=1245 ${workspaceFolder}/src/$PRODUCT_NAME.bas ${workspaceFolder}/dist/$PRODUCT_NAME.img"
        },
        {
            "label": "make wav file(bas)",
            "type": "shell",
            "command": "source ${workspaceFolder}/.vscode/tasks.env; bin2wav --pc=1245 --type=img ${workspaceFolder}/dist/$PRODUCT_NAME.img ${workspaceFolder}/wav/$PRODUCT_NAME-bas.wav",
            "dependsOn": "bas2img"
        },
        {
            "label": "make wav file(bin)",
            "type": "shell",
            "command": "source ${workspaceFolder}/.vscode/tasks.env; bin2wav --pc=1245 --type=bin --addr=0xc500 ${workspaceFolder}/dist/$PRODUCT_NAME.bin ${workspaceFolder}/wav/$PRODUCT_NAME-bin-C500.wav",
            "dependsOn": "assemble"
        },
        {
            "label": "deploy to PokecomGo(bas)",
            "type": "shell",
            "command": "source ${workspaceFolder}/.vscode/tasks.env; adb push ${workspaceFolder}/src/$PRODUCT_NAME.bas /sdcard/share",
        },
        {
            "label": "deploy to PokecomGo(bin)",
            "type": "shell",
            "command": "source ${workspaceFolder}/.vscode/tasks.env; adb push ${workspaceFolder}/dist/$PRODUCT_NAME.bin /sdcard/share/$PRODUCT_NAME-C500.bin",
            "dependsOn": "assemble"
        },
        {
            "label": "install to sc61box(bin)",
            "type": "shell",
            "command": "source ${workspaceFolder}/.vscode/tasks.env; cp dist/$PRODUCT_NAME.bin ~/.sc61box/programs/$PRODUCT_NAME.bin",
            "dependsOn": "assemble"
        },
        {
            "label": "install to sc61box(bas)",
            "type": "shell",
            "command": "source ${workspaceFolder}/.vscode/tasks.env; { echo '# title: ' $PRODUCT_NAME; echo '# bin: ' $PRODUCT_NAME.bin ' &C500'; cat src/$PRODUCT_NAME.bas;} > ~/.sc61box/programs/$PRODUCT_NAME.bas",
        },
        {
            "label": "Start sc61box",
            "type": "shell",
            "command": "source ${workspaceFolder}/.vscode/tasks.env; set +a; cd $SC61BOX_HOME; uv run sc61box --fresh --model 1245",
        },   
    ]
}
